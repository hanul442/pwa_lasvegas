# Persistence backend. Local development defaults to json; production should use supabase.
VEGAS_PERSISTENCE_BACKEND="json"

# Dedicated SOCIAL VEGAS Supabase project. Never reuse the BLACK ORACLE project.
VEGAS_SUPABASE_URL="https://YOUR_VEGAS_PROJECT_REF.supabase.co"
VEGAS_SUPABASE_ANON_KEY="YOUR_VEGAS_ANON_KEY"

# Server-only capability used by the private runtime-state RPC bridge.
# Never expose this value in public JavaScript or commit a real value.
VEGAS_DB_SERVER_SECRET="YOUR_LONG_RANDOM_SERVER_SECRET"
